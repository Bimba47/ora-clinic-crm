{
  "name": "אורי · התור הבא",
  "nodes": [
    {
      "id": "wh",
      "name": "Receive request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ora-next-appointment",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "v",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const b = ($input.first().json.body) || {};\nconst name = String(b.name == null ? '' : b.name).trim();\nconst description = String(b.description == null ? '' : b.description).trim();\nlet d = String(b.phone == null ? '' : b.phone).replace(/\\D/g, '');\nif (d.startsWith('972')) d = '0' + d.slice(3);\nelse if (d && !d.startsWith('0')) d = '0' + d;\nconst phone = (d.length === 9 || d.length === 10) ? d : '';\nif (!phone) return [{ json: { ok: false, response: { status: 'invalid_request',\n  summary: 'לא התקבל טלפון תקין, לא ניתן לבדוק את התור.' } } }];\nreturn [{ json: { ok: true, phone } }];"
      }
    },
    {
      "id": "ok1",
      "name": "Request valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "g1",
      "name": "Find client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -80
      ],
      "parameters": {
        "method": "GET",
        "url": "https://ora-clinic-crm-liart.vercel.app/api/v1/clients",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        },
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ phone: $json.phone }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "d1",
      "name": "Client found?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -80
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r || r.error || !Array.isArray(r.data)) return [{ json: { state: 'error' } }];\nif (r.data.length === 0) return [{ json: { state: 'not_found' } }];\nif (r.data.length > 1) return [{ json: { state: 'error' } }];\nconst id = encodeURIComponent(r.data[0].id);\nconst apptUrl = 'https://ora-clinic-crm-liart.vercel.app/api/v1/appointments?client_id=' + id + '&status%5Bneq%5D=cancelled&starts_at%5Bgte%5D=%7B%7Bnow%7D%7D&sort=starts_at&limit=1';\nreturn [{ json: { state: 'ok', clientId: r.data[0].id, clientName: r.data[0].full_name, apptUrl } }];"
      }
    },
    {
      "id": "hc",
      "name": "Client ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.state === \"ok\" }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ga",
      "name": "Get next appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -160
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.apptUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "r1",
      "name": "Build response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "let c;\ntry { c = $('Client found?').first().json; } catch (e) { c = { state: 'error' }; }\nconst a = $input.first().json;\nconst msgErr = { json: { response: { status: 'error',\n  summary: 'לא הצלחתי לבדוק את התור כרגע. אין לנחש תאריך.' } } };\nif (c.state === 'not_found') return [{ json: { response: { status: 'client_not_found',\n  summary: 'לא נמצאה לקוחה עם הטלפון הזה ברשומות שנבדקו, ולכן אין תור עתידי להציג.' } } }];\nif (c.state !== 'ok') return [msgErr];\nif (!a || a.error || !Array.isArray(a.data)) return [msgErr];\nif (a.data.length === 0) return [{ json: { response: { status: 'no_upcoming',\n  summary: 'אין תור עתידי ברשומות שנבדקו.' } } }];\nconst x = a.data[0];\nconst dt = new Date(x.starts_at);\nconst tz = 'Asia/Jerusalem';\nconst day = new Intl.DateTimeFormat('he-IL', { timeZone: tz, weekday: 'long' }).format(dt);\nconst date = new Intl.DateTimeFormat('en-GB', { timeZone: tz, day: '2-digit', month: '2-digit', year: 'numeric' }).format(dt).replace(/\\//g, '.');\nconst time = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(dt);\nconst treatment = x.treatment_id__label || '';\nif (!treatment) return [msgErr];\nreturn [{ json: { response: { status: 'found', day, date, time, treatment,\n  summary: 'התור הבא: ' + day + ' ' + date + ' בשעה ' + time + ', ' + treatment + '.' } } }];"
      }
    },
    {
      "id": "rsp",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.response }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
