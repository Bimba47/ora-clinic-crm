# ============================================================
# קובץ דוגמה: CRM קליניקת אורה
# הקובץ הזה עולה ל-GitHub ומראה אילו משתנים צריך. אין בו ערכים אמיתיים, ואסור להכניס לכאן ערכים.
# כדי לעבוד מקומית: מעתיקים אותו לקובץ בשם .env.local וממלאים שם.
# ============================================================


# ############################################################
# חלק א: משתנים שענבל ממלאת
# ############################################################

# שם הפרויקט באנגלית, לשמות טכניים (ריפו, פרויקט ב-Vercel). אותיות קטנות ומקפים בלבד, למשל: ora-clinic-crm
PROJECT_NAME=

# שם המערכת בעברית, לכותרות בממשק. מוצג בדפדפן, ולכן הוא ציבורי. למשל: קליניקת אורה
NEXT_PUBLIC_APP_NAME=

# טוקן GitHub: מאפשר לכלים להעלות קוד לריפו.
# מאיפה: github.com > Settings > Developer settings > Personal access tokens > Fine-grained tokens. לתת הרשאה רק לריפו של הפרויקט.
GITHUB_TOKEN=

# טוקן Supabase (Access Token של החשבון): מאפשר לכלי Supabase לנהל את הפרויקט.
# מאיפה: supabase.com/dashboard/account/tokens > Generate new token.
SUPABASE_ACCESS_TOKEN=

# טוקן Vercel: מאפשר לכלים לפרוס ולבדוק פריסות.
# מאיפה: vercel.com/account/tokens > Create Token.
VERCEL_TOKEN=


# ############################################################
# חלק ב: משתנים ש-Claude ימלא בשלב הבא (להשאיר ריק)
# ############################################################

# --- זמינים לצד הלקוח (בדפדפן). בטוחים לחשיפה, כי ההרשאות נאכפות ב-RLS ---

# כתובת פרויקט ה-Supabase.
# מאיפה: Supabase > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# המפתח הציבורי (Publishable / anon key).
# מאיפה: Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- צד שרת בלבד. אף פעם לא בדפדפן ואף פעם לא עם NEXT_PUBLIC_ ---

# המפתח הרגיש (Secret / service_role key): עוקף את כל ההרשאות. משמש רק בשרת, למשל להזמנת משתמשות.
# מאיפה: Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# מזהה הפרויקט (Project Ref): המחרוזת בכתובת של הפרויקט.
# מאיפה: Supabase > Project Settings > General > Project ID.
SUPABASE_PROJECT_REF=

# סיסמת בסיס הנתונים: לחיבור ישיר למסד ולהרצת מיגרציות.
# מאיפה: Supabase > Project Settings > Database > Reset database password (היא מוצגת רק בזמן היצירה).
SUPABASE_DB_PASSWORD=
